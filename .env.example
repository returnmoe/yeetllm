# Global configuration. Per-model options belong in YAML.
YEETLLM_CONFIG=/workspace/yeetllm/config.yaml
# Optional: fetch YAML over HTTPS, validate it, then atomically write it to
# YEETLLM_CONFIG before startup. Signed URLs are supported and never logged.
YEETLLM_CONFIG_URL=
# Optional integrity pin for YEETLLM_CONFIG_URL (64 lowercase/uppercase hex digits).
YEETLLM_CONFIG_SHA256=

# "auto" starts sshd only after a valid public key is detected.
YEETLLM_SSH_ENABLE=auto
YEETLLM_SSH_PORT=22
YEETLLM_SSH_AUTHORIZED_KEYS=

# RunPod compatibility key sources are also supported:
# SSH_PUBLIC_KEY=
# PUBLIC_KEY=

# Required only for gated or private Hugging Face repositories.
HF_TOKEN=
HF_HOME=/workspace/yeetllm/cache/huggingface
HUGGINGFACE_HUB_CACHE=/workspace/yeetllm/cache/huggingface/hub
VLLM_CACHE_ROOT=/workspace/yeetllm/cache/vllm

# Set only while diagnosing distributed communication.
# NCCL_DEBUG=INFO
